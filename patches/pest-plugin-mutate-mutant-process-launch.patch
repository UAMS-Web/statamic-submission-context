     public function setOriginalArguments(array $arguments): void
     {
+        // Each mutant runs in a child process built from these arguments, with argv[0]
+        // reused verbatim as the executable. PHP sets argv[0] to the script path AS TYPED,
+        // so `php vendor/bin/pest` hands the child a forward-slashed relative path, which
+        // cmd.exe cannot launch. The child exits non-zero, and hasFinished() reads any
+        // non-zero exit as "the test failed" -- so every mutant is scored killed without
+        // being executed, and the run reports 100.00%. See uams-statamic#2322.
+        if ($arguments !== [] && DIRECTORY_SEPARATOR !== '/') {
+            $arguments[0] = str_replace('/', DIRECTORY_SEPARATOR, $arguments[0]);
+        }
+
         $this->originalArguments = $arguments;
     }
 
