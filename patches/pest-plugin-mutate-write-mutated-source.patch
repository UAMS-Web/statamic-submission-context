+        set_error_handler(static function (int $level, string $message) use (&$error): bool {
+            $error = $message;
+
+            return true;
+        });
+
+        try {
+            if (! is_dir($directory) && ! mkdir($directory, 0777, true) && ! is_dir($directory)) {
+                throw new \RuntimeException(sprintf('Unable to create the mutations directory [%s]: %s', $directory, $error));
+            }
+
+            if (file_put_contents($path, $modifiedSource) === false) {
+                throw new \RuntimeException(sprintf('Unable to write the mutated source to [%s]: %s', $path, $error));
+            }
+        } finally {
+            restore_error_handler();
+        }
+
+        return $path;
