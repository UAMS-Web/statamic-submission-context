ignore-scripts=true
min-release-age=3

# `min-release-age` is only honored by npm >= 11.10.0 (2026-02-11). Under anything older npm
# drops the key silently — no warning, no non-zero exit — so the cooldown never applies. The
# floor is declared in `package.json` (`engines.npm`) and `engine-strict` is what turns that
# declaration into a refusal rather than an advisory warning. See #1826.
engine-strict=true
