/phpunit.xml export-ignore
/pint.json export-ignore
/rector-sweep.php export-ignore
/rector.php export-ignore
/tests/ export-ignore
/vendor/ export-ignore
/patches/ export-ignore
/patches.json export-ignore
/patches.lock.json export-ignore
/.npmrc export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/scripts/ export-ignore
/vitest.config.js export-ignore
/vite.config.js export-ignore

# Append-only decision log: two branches that each add an entry merge without a conflict.
/docs/DECISIONS.md merge=union
